{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "modpoll:version",
    "modpoll:acquisition"
  ],
  "properties": {
    "modpoll:version": {
      "const": "0.1"
    },
    "modpoll:acquisition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "modpoll:table",
          "modpoll:start",
          "modpoll:quantity",
          "modpoll:byteOrder",
          "modpoll:members"
        ],
        "additionalProperties": false,
        "properties": {
          "modpoll:table": {
            "enum": [
              "coil",
              "discrete_input",
              "input_register",
              "holding_register"
            ]
          },
          "modpoll:start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "modpoll:quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "modpoll:byteOrder": {
            "enum": [
              "BE_BE",
              "BE_LE",
              "LE_BE",
              "LE_LE"
            ]
          },
          "modpoll:members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "modpoll:property",
                "modpoll:offset",
                "modpoll:dataType"
              ],
              "additionalProperties": false,
              "properties": {
                "modpoll:property": {
                  "type": "string",
                  "minLength": 1
                },
                "modpoll:offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "modpoll:dataType": {
                  "type": "string",
                  "pattern": "^(u?int(16|32|64)|float(16|32|64)|bool(8|16)?|string[1-9][0-9]*)$"
                },
                "modpoll:bit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                },
                "modpoll:multiplier": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
