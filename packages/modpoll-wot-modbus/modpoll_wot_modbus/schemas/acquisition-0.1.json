{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "modpoll:version",
    "modpoll:acquisition"
  ],
  "properties": {
    "modpoll:version": {
      "const": "0.1"
    },
    "modpoll:acquisition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "modv:entity",
          "modv:address",
          "modv:quantity",
          "modv:mostSignificantByte",
          "modv:mostSignificantWord",
          "modpoll:members"
        ],
        "additionalProperties": false,
        "properties": {
          "modv:entity": {
            "enum": [
              "Coil",
              "DiscreteInput",
              "InputRegister",
              "HoldingRegister"
            ]
          },
          "modv:address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "modv:quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "modv:mostSignificantByte": {
            "type": "boolean"
          },
          "modv:mostSignificantWord": {
            "type": "boolean"
          },
          "modpoll:members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "modpoll:property",
                "modpoll:offset",
                "modpoll:dataType"
              ],
              "additionalProperties": false,
              "properties": {
                "modpoll:property": {
                  "type": "string",
                  "minLength": 1
                },
                "modpoll:offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "modpoll:dataType": {
                  "type": "string",
                  "pattern": "^(u?int(16|32|64)|float(16|32|64)|bool(8|16)?|string[1-9][0-9]{0,3})$"
                },
                "modpoll:bit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                },
                "modpoll:multiplier": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "pattern": "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?$"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
